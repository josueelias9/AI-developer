{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "AI Developer: Run (my_app)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/my_app/my_agent/agent.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/my_app",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/my_app",
                "OLLAMA_HOST": "http://localhost:11434",
                "OLLAMA_MODEL": "qwen2.5:7b",
                "OLLAMA_CODER": "qwen2.5-coder:7b",
                "OUTPUT_DIR": "${workspaceFolder}/my_app/.generated"
            }
        },
        {
            "name": "🟢 AI Developer: Evaluate (LangSmith)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/evaluate.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/my_app",
                "LANGCHAIN_TRACING_V2": "true",
                "LANGCHAIN_API_KEY": "",
                "LANGCHAIN_PROJECT": "ai-developer-eval",
                "OLLAMA_HOST": "http://localhost:11434",
                "OLLAMA_MODEL": "qwen2.5:7b",
                "OLLAMA_CODER": "qwen2.5-coder:7b"
            }
        }
    ]
}